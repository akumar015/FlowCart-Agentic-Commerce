# FlowCart Environment Variables
# Copy this file to chat_agent/.env and fill in your actual credentials

# Google Gemini API Key (Required for conversational agent & recommender)
GOOGLE_API_KEY=your_gemini_api_key_here

# Razorpay Test API Credentials (Required for Orders, Payment Links & Autopay Mandates)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret_here
